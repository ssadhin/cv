<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer 3 (Most diffused, offset 6dp) -->
    <item android:top="12dp" android:left="12dp" android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D000000" />
            <corners android:radius="1000dp" />
        </shape>
    </item>
    <!-- Shadow Layer 2 (Medium, offset 4dp) -->
    <item android:top="10dp" android:left="10dp" android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="1000dp" />
        </shape>
    </item>
    <!-- Shadow Layer 1 (Darkest/Nearest, offset 2dp) -->
    <item android:top="8dp" android:left="8dp" android:bottom="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
            <corners android:radius="1000dp" />
        </shape>
    </item>
    <!-- Foreground Layer (Perfectly Centered in 84x84) -->
    <item android:top="6dp" android:left="6dp" android:bottom="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/fab_purple_main" />
            <corners android:radius="1000dp" />
        </shape>
    </item>
</layer-list>
