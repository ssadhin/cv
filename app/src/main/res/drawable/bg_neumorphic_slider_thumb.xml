<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer slight shadow to simulate thumb elevation -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#22000000" />
            <size android:width="24dp" android:height="24dp" />
        </shape>
    </item>

    <!-- Medium shadow transition -->
    <item android:top="0.5dp" android:bottom="0.5dp" android:left="0.5dp" android:right="0.5dp">
        <shape android:shape="oval">
            <solid android:color="#11000000" />
        </shape>
    </item>

    <!-- Inner soft border for frosted look -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#F0EEF8" />
        </shape>
    </item>

    <!-- Main White body of the thumb -->
    <item android:top="1.5dp" android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Central Purple Dot -->
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <solid android:color="#8A52FF" />
        </shape>
    </item>
</layer-list>
