<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">
            <group android:name="scene_root">
                <!-- 1. HEARTS SHADOW / HALVES -->
                <group android:name="h_left_root" android:pivotX="24" android:pivotY="36">
                    <path android:name="path_half_left" android:fillColor="#e91e63" android:pathData="M24,36 C14,30 8,24 8,16 C8,10 13,8 16,8 C19,8 22,10 24,12 L24,36 Z" />
                </group>
                <group android:name="h_right_root" android:pivotX="24" android:pivotY="36">
                    <path android:name="path_half_right" android:fillColor="#e91e63" android:pathData="M24,36 L24,12 C26,10 30,8 34,8 C39,8 44,12 44,18 C44,24 38,30 24,36 Z" />
                </group>

                <!-- 2. FULL HEART (Initially tiny) -->
                <group android:name="h_full_root" android:pivotX="24" android:pivotY="36" android:scaleX="0.01" android:scaleY="0.01">
                    <path android:name="path_full_heart" android:fillColor="#e91e63" android:pathData="M24,40 L21.5,37.7 C13.4,30.4 8,25.5 8,19.5 C13.4,19.5 17,23.1 24,30.1 C31,23.1 34.6,19.5 40,19.5 C40,25.5 34.6,30.4 26.5,37.7 L24,40 Z" />
                </group>

                <!-- 3. RINGS + DIAMOND + SHINE (Top layer) -->
                <group android:name="rings_root" android:pivotX="24" android:pivotY="24" android:scaleX="0.01" android:scaleY="0.01">
                    <!-- Gold Rings -->
                    <path android:name="ring1" android:strokeColor="#FFD700" android:strokeWidth="2.5" android:pathData="M20,24 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0" />
                    <path android:name="ring2" android:strokeColor="#FFD700" android:strokeWidth="2.5" android:pathData="M28,24 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0" />

                    <!-- DIAMOND (Octahedron shape on the left ring top) -->
                    <group android:name="diamond_group" android:pivotX="16" android:pivotY="18" android:scaleX="1.2" android:scaleY="1.2">
                        <path android:name="diamond_main" android:fillColor="#B2EBF2" android:pathData="M16,15 L19,18 L16,21 L13,18 Z" />
                        <path android:name="diamond_facet" android:fillColor="#ffffff" android:fillAlpha="0.7" android:pathData="M16,15 L17.5,18 L16,19.5 L14.5,18 Z" />
                    </group>

                    <!-- SHINE / GLINT (Grows and flashes) -->
                    <group android:name="shine_root" android:pivotX="16" android:pivotY="18" android:scaleX="0.01" android:scaleY="0.01">
                        <path android:name="glint_horizontal" android:strokeColor="#ffffff" android:strokeWidth="1.2" android:strokeLineCap="round" android:pathData="M12,18 L20,18" />
                        <path android:name="glint_vertical" android:strokeColor="#ffffff" android:strokeWidth="1.2" android:strokeLineCap="round" android:pathData="M16,14 L16,22" />
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- ANIMS: Master Sequential Timeline -->

    <!-- HEARTS: Flight -> Bump -> Stare -> Shrink -->
    <target android:name="h_left_root">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateX" android:duration="600" android:valueFrom="-40" android:valueTo="0" />
                <objectAnimator android:propertyName="translateY" android:duration="600" android:valueFrom="-20" android:valueTo="0" />
                <objectAnimator android:propertyName="scaleX" android:duration="600" android:valueFrom="0.1" android:valueTo="1.0" />
                <objectAnimator android:propertyName="scaleY" android:duration="600" android:valueFrom="0.1" android:valueTo="1.0" />

                <objectAnimator android:propertyName="translateX" android:startOffset="600" android:duration="150" android:valueFrom="0" android:valueTo="4" />
                <objectAnimator android:propertyName="translateX" android:startOffset="750" android:duration="150" android:valueFrom="4" android:valueTo="0" />

                <objectAnimator android:propertyName="scaleX" android:startOffset="2300" android:duration="400" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="2300" android:duration="400" android:valueFrom="1.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="h_right_root">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="translateX" android:duration="600" android:valueFrom="40" android:valueTo="0" />
                <objectAnimator android:propertyName="translateY" android:duration="600" android:valueFrom="-20" android:valueTo="0" />
                <objectAnimator android:propertyName="scaleX" android:duration="600" android:valueFrom="0.1" android:valueTo="1.0" />
                <objectAnimator android:propertyName="scaleY" android:duration="600" android:valueFrom="0.1" android:valueTo="1.0" />

                <objectAnimator android:propertyName="translateX" android:startOffset="600" android:duration="150" android:valueFrom="0" android:valueTo="-4" />
                <objectAnimator android:propertyName="translateX" android:startOffset="750" android:duration="150" android:valueFrom="-4" android:valueTo="0" />

                <objectAnimator android:propertyName="scaleX" android:startOffset="2300" android:duration="400" android:valueFrom="1.0" android:valueTo="0.0" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="2300" android:duration="400" android:valueFrom="1.0" android:valueTo="0.0" />
            </set>
        </aapt:attr>
    </target>

    <!-- RINGS + DIAMOND: Emerge (1400) -->
    <target android:name="rings_root">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:startOffset="1400" android:duration="700" android:valueFrom="0.01" android:valueTo="1.0" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="1400" android:duration="700" android:valueFrom="0.01" android:valueTo="1.0" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:startOffset="1400" android:duration="1200" android:valueFrom="0" android:valueTo="360" />
            </set>
        </aapt:attr>
    </target>

    <!-- SHINE / GLINT: Flare up (1900) -->
    <target android:name="shine_root">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:startOffset="1900" android:duration="300" android:valueFrom="0.01" android:valueTo="1.8" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="1900" android:duration="300" android:valueFrom="0.01" android:valueTo="1.8" />
                <objectAnimator android:propertyName="scaleX" android:startOffset="2200" android:duration="300" android:valueFrom="1.8" android:valueTo="0.0" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="2200" android:duration="300" android:valueFrom="1.8" android:valueTo="0.0" />
                <objectAnimator android:propertyName="rotation" android:startOffset="1900" android:duration="600" android:valueFrom="0" android:valueTo="90" />
            </set>
        </aapt:attr>
    </target>

    <!-- FULL HEART: Grow during merge (2300) -->
    <target android:name="h_full_root">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:startOffset="2300" android:duration="500" android:valueFrom="0.01" android:valueTo="1.0" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="2300" android:duration="500" android:valueFrom="0.01" android:valueTo="1.0" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
