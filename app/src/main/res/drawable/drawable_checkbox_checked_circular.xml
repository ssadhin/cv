<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- White Circle Background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_card_nested"/>
            <size android:width="24dp" android:height="24dp"/>
        </shape>
    </item>
    <!-- Green Checkmark centered with padding -->
    <item android:gravity="center" android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp" android:drawable="@drawable/ic_check_green" />
</layer-list>
