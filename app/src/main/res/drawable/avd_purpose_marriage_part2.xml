<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="48dp" android:height="48dp" android:viewportWidth="48" android:viewportHeight="48">
            <group android:name="scene_root">
                <!-- Half Hearts (End state of part 1) -->
                <group android:name="half_left_group" android:pivotX="24" android:pivotY="36">
                    <path android:name="path_half_left" android:fillAlpha="1.0" android:fillColor="#e91e63" android:pathData="M24,36 C14,30 8,24 8,16 C8,10 13,8 16,8 C19,8 22,10 24,12 L24,36 Z" />
                </group>
                <group android:name="half_right_group" android:pivotX="24" android:pivotY="36">
                    <path android:name="path_half_right" android:fillAlpha="1.0" android:fillColor="#e91e63" android:pathData="M24,36 L24,12 C26,10 30,8 34,8 C39,8 44,12 44,18 C44,24 38,30 24,36 Z" />
                </group>

                <!-- Full Heart (Initial hidden) -->
                <path android:name="path_full_heart" android:fillAlpha="0.0" android:fillColor="#e91e63" android:pathData="M24,40 L21.5,37.7 C13.4,30.4 8,25.5 8,19.5 C13.4,19.5 17,23.1 24,30.1 C31,23.1 34.6,19.5 40,19.5 C40,25.5 34.6,30.4 26.5,37.7 L24,40 Z" />

                <!-- Golden Rings -->
                <group android:name="rings_root" android:pivotX="24" android:pivotY="24" android:scaleX="0" android:scaleY="0">
                    <path android:name="ring1" android:strokeAlpha="0.0" android:strokeColor="#FFD700" android:strokeWidth="2.5" android:pathData="M20,24 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0" />
                    <path android:name="ring2" android:strokeAlpha="0.0" android:strokeColor="#FFD700" android:strokeWidth="2.5" android:pathData="M28,24 m-7,0 a7,7 0 1,1 14,0 a7,7 0 1,1 -14,0" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- RINGS EMERGE (Starts at 1000ms stare) -->
    <target android:name="rings_root">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:startOffset="1000" android:duration="1000" android:valueFrom="0.0" android:valueTo="1.0" android:valueType="floatType" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:startOffset="1000" android:duration="1000" android:valueFrom="0.0" android:valueTo="1.0" android:valueType="floatType" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="rotation" android:startOffset="1000" android:duration="1500" android:valueFrom="0" android:valueTo="360" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ring1">
        <objectAnimator android:propertyName="strokeAlpha" android:startOffset="1000" android:duration="500" android:valueFrom="0.0" android:valueTo="1.0" android:valueType="floatType" />
    </target>
    <target android:name="ring2">
        <objectAnimator android:propertyName="strokeAlpha" android:startOffset="1000" android:duration="500" android:valueFrom="0.0" android:valueTo="1.0" android:valueType="floatType" />
    </target>

    <!-- FINAL MERGE (Starts at 2500ms) -->
    <target android:name="path_half_left">
        <objectAnimator android:propertyName="fillAlpha" android:startOffset="2500" android:duration="600" android:valueFrom="1.0" android:valueTo="0.0" android:valueType="floatType" />
    </target>
    <target android:name="path_half_right">
        <objectAnimator android:propertyName="fillAlpha" android:startOffset="2500" android:duration="600" android:valueFrom="1.0" android:valueTo="0.0" android:valueType="floatType" />
    </target>
    <target android:name="path_full_heart">
        <objectAnimator android:propertyName="fillAlpha" android:startOffset="2500" android:duration="600" android:valueFrom="0.0" android:valueTo="1.0" android:valueType="floatType" />
    </target>
</animated-vector>
