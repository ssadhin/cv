<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/side_panel_left"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="0dp"
    app:layout_constraintWidth_percent="0.106"
    app:layout_constraintHeight_percent="0.51"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:id="@+id/panel_content_layout_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/swap_button_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/custom_shadow" />

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/swap" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/pill_background"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/column_width_button_left"
                        layout="@layout/panel_button" />

                    <FrameLayout
                        android:id="@+id/column_width_slider_container_left"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:visibility="gone">

                        <SeekBar
                            android:id="@+id/column_width_slider_left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="100"
                            android:progress="50" />
                    </FrameLayout>

                    <include
                        android:id="@+id/toggle_icons_button_left"
                        layout="@layout/panel_button" />

                    <include
                        android:id="@+id/delete_button_left"
                        layout="@layout/panel_button" />

                    <include
                        android:id="@+id/zoom_button_left"
                        layout="@layout/panel_button" />

                    <FrameLayout
                        android:id="@+id/zoom_slider_container_left"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:visibility="gone">

                        <SeekBar
                            android:id="@+id/zoom_slider_left"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="100"
                            android:progress="25"
                            android:rotation="270" />
                    </FrameLayout>

                    <include
                        android:id="@+id/font_size_button_left"
                        layout="@layout/panel_button" />

                    <FrameLayout
                        android:id="@+id/font_size_slider_container_left"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:visibility="gone">

                        <SeekBar
                            android:id="@+id/font_size_slider_left"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="14"
                            android:progress="4"
                            android:rotation="270" />
                    </FrameLayout>

                    <include
                        android:id="@+id/font_color_button_left"
                        layout="@layout/panel_button" />

                    <include
                        android:id="@+id/line_spacing_button_left"
                        layout="@layout/panel_button" />

                    <FrameLayout
                        android:id="@+id/line_spacing_slider_container_left"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:visibility="gone">

                        <SeekBar
                            android:id="@+id/line_spacing_slider_left"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:max="99"
                            android:progress="49"
                            android:rotation="270" />
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/hide_button_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/custom_shadow" />

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:scaleType="fitCenter"
                android:src="@drawable/hide" />
        </FrameLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
