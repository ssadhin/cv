<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:layout_marginVertical="6dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface_dialog" app:strokeWidth="1dp" app:strokeColor="@color/divider_color_new">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

        <!-- Top Row: Avatar, Name, Score -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

            <ImageView android:id="@+id/iv_review_avatar" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_person" app:tint="#999999" android:background="@drawable/bg_circle_outline" android:padding="6dp" />

            <TextView android:id="@+id/tv_review_username" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Username" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_primary" android:layout_marginStart="10dp" />

            <!-- User given rating -->
            <TextView android:id="@+id/tv_review_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8/10" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/text_secondary" android:background="@color/surface_card_nested" android:paddingHorizontal="10dp" android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Review Text -->
        <TextView android:id="@+id/tv_review_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="This template is good." android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:layout_marginStart="42dp" />

        <!-- Attached Images Layout (Max 3) -->
        <LinearLayout android:id="@+id/layout_review_images" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:layout_marginStart="42dp" android:visibility="gone">

            <ImageView android:id="@+id/iv_review_image_1" android:layout_width="60dp" android:layout_height="60dp" android:scaleType="centerCrop" android:background="#E0E0E0" android:layout_marginEnd="8dp" android:visibility="gone" />

            <ImageView android:id="@+id/iv_review_image_2" android:layout_width="60dp" android:layout_height="60dp" android:scaleType="centerCrop" android:background="#E0E0E0" android:layout_marginEnd="8dp" android:visibility="gone" />

            <ImageView android:id="@+id/iv_review_image_3" android:layout_width="60dp" android:layout_height="60dp" android:scaleType="centerCrop" android:background="#E0E0E0" android:visibility="gone" />
        </LinearLayout>

        <!-- Action Buttons (Edit/Delete) - Only shown for own reviews -->
        <LinearLayout android:id="@+id/layout_review_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="8dp" android:visibility="gone">

            <ImageButton android:id="@+id/btn_edit_review" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_edit" app:tint="#2196F3" android:padding="8dp" android:contentDescription="Edit Review" />

            <ImageButton android:id="@+id/btn_delete_review" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_delete" app:tint="#F44336" android:padding="8dp" android:contentDescription="Delete Review" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
