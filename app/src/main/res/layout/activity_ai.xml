<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary" tools:context=".AIActivity">

    <LinearLayout android:id="@+id/aiToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/bg_card" android:elevation="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp" app:layout_constraintTop_toTopOf="parent">

        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_revert" app:tint="@color/text_primary" android:stateListAnimator="@animator/wobbly_slime" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="@string/ai_assistant" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />

    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@id/aiToolbar">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ai_data_input" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ai_data_desc" android:textColor="@color/text_secondary" android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnCopyPrompt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_gravity="start" android:text="@string/copy_master_prompt" android:textSize="12sp" app:icon="@android:drawable/ic_menu_edit" app:cornerRadius="16dp" app:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" app:iconTint="@color/text_primary" />

            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/resume_data_hint" app:boxStrokeColor="@color/text_secondary" app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etJsonInput" android:layout_width="match_parent" android:layout_height="250dp" android:gravity="top" android:inputType="textMultiLine" android:fontFamily="monospace" android:textSize="14sp" android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="start">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnPaste" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paste_btn" android:textSize="12sp" app:icon="@android:drawable/ic_menu_agenda" app:cornerRadius="16dp" app:backgroundTint="@color/bg_button" android:textColor="@color/text_primary" app:iconTint="@color/text_primary" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/clear_btn" android:textSize="12sp" app:icon="@android:drawable/ic_menu_close_clear_cancel" app:cornerRadius="16dp" app:backgroundTint="@color/accent_red_bg" android:textColor="@color/accent_red" app:iconTint="@color/accent_red" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnNext" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="@string/next_choose_template" android:textAllCaps="false" android:textSize="16sp" app:cornerRadius="8dp" app:backgroundTint="@color/text_primary" android:textColor="@color/bg_primary" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
