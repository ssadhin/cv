<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/step2Container" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/progress" android:textColor="@color/text_secondary" android:textSize="12sp" android:letterSpacing="0.1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-black" android:text="@string/choosing_ai_model" android:textColor="@color/text_primary" android:textSize="18sp" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/surface_card_nested" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="@string/step_2_of_3" android:textColor="@color/brand_primary" android:textSize="13sp" android:textStyle="bold" android:drawablePadding="4dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:fontFamily="sans-serif-black" android:text="@string/ai_step_2_title" android:textColor="@color/text_primary" android:textSize="32sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ai_step_2_desc" android:textColor="@color/text_secondary" android:textSize="16sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical">
            <!-- Gemini -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardGemini" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/divider_color_new" app:strokeWidth="1dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/bg_card" android:stateListAnimator="@animator/wobbly_slime">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <ImageView android:id="@+id/ivGemini" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_gemini_logo" android:padding="8dp" android:background="@color/surface_pink"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivGemini" android:layout_toStartOf="@+id/ivArrowGemini" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_google" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_google_desc" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView android:id="@+id/ivArrowGemini" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_arrow_right" app:tint="@color/text_secondary"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ChatGPT -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardChatGPT" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/divider_color_new" app:strokeWidth="1dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/bg_card" android:stateListAnimator="@animator/wobbly_slime">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <ImageView android:id="@+id/ivChatGPT" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_chatgpt_logo" android:padding="8dp" android:background="@color/surface_lavender"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivChatGPT" android:layout_toStartOf="@+id/ivArrowChatGPT" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_chatgpt" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_chatgpt_desc" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView android:id="@+id/ivArrowChatGPT" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_arrow_right" app:tint="@color/text_secondary"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grok -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardGrok" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/divider_color_new" app:strokeWidth="1dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/bg_card" android:stateListAnimator="@animator/wobbly_slime">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <ImageView android:id="@+id/ivGrok" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_grok_logo" android:padding="8dp" android:background="@color/surface_gray"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivGrok" android:layout_toStartOf="@+id/ivArrowGrok" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_grok" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_grok_desc" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView android:id="@+id/ivArrowGrok" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_arrow_right" app:tint="@color/text_secondary"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DeepSeek -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardDeepSeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/divider_color_new" app:strokeWidth="1dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/bg_card" android:stateListAnimator="@animator/wobbly_slime">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <ImageView android:id="@+id/ivDeepSeek" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_deepseek_logo" android:padding="8dp" android:background="@color/surface_purple"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/ivDeepSeek" android:layout_toStartOf="@+id/ivArrowDeepSeek" android:layout_marginStart="16dp" android:layout_centerVertical="true" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_deepseek" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_model_deepseek_desc" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    </LinearLayout>
                    <ImageView android:id="@+id/ivArrowDeepSeek" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_arrow_right" app:tint="@color/text_secondary"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_card_nested" app:strokeColor="@color/divider_color_new" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_dialog_info" app:tint="@color/brand_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/next_step_label" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/text_primary"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/next_step_desc" android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnContinueToStep3" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginTop="32dp" android:text="@string/ai_continue_prompt" android:textAllCaps="false" android:textSize="18sp" android:textStyle="bold" app:cornerRadius="24dp" app:backgroundTint="@color/brand_primary" android:textColor="#FFFFFF" />

        <TextView android:id="@+id/btnBackToStep1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="20dp" android:layout_marginBottom="24dp" android:text="@string/back_to_step_1" android:textColor="@color/text_secondary" android:textSize="15sp" android:textStyle="bold" android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>
</ScrollView>
