<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp">

    <!-- Title / Drag Handle Area -->
    <View android:layout_width="40dp" android:layout_height="4dp" android:background="#E0E0E0" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:backgroundTint="#CCCCCC"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Section Settings" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="16dp" android:gravity="center" android:textColor="#000000"/>

    <!-- BOX 1: SETTINGS -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/rounded_box_bg" android:padding="12dp" android:layout_marginBottom="16dp" android:elevation="2dp">

        <!-- Identity -->
        <LinearLayout android:id="@+id/container_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <!-- Icon Changer -->
                <FrameLayout android:id="@+id/headerIconContainer" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/circle_shape" android:backgroundTint="#EEF2FF" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <ImageView android:id="@+id/headerIcon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_star" android:scaleType="centerCrop" app:tint="#1E3C72"/>
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@android:drawable/ic_menu_edit" android:layout_gravity="bottom|end" android:layout_margin="4dp" app:tint="#666666"/>
                </FrameLayout>
                <View android:layout_width="16dp" android:layout_height="1dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Section Title" android:textSize="12sp" android:textColor="#888888"/>
                    <EditText android:id="@+id/headerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Section Name" android:textSize="18sp" android:textStyle="bold" android:background="@null" android:inputType="textCapWords" android:imeOptions="actionDone" android:textColor="#000000"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="12dp"/>

        <!-- ROW 1: Style & Background (Right Aligned) -->
        <LinearLayout android:id="@+id/container_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end|center_vertical" android:paddingBottom="12dp">
            <LinearLayout android:id="@+id/btnHeaderStyle" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_star" app:tint="#666666" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Style" android:textSize="12sp" android:textStyle="bold" android:textColor="#666666"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btnSectionColor" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_circle_colorful" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Background" android:textSize="12sp" android:textStyle="bold" android:textColor="#666666"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2: Align, Grid, Apply to All (Right Aligned) -->
        <LinearLayout android:id="@+id/container_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end|center_vertical" android:paddingBottom="12dp">
            <LinearLayout android:id="@+id/btnAlignment" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_swap" app:tint="#666666" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Align" android:textSize="12sp" android:textStyle="bold" android:textColor="#666666"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btnGrid" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_marginEnd="8dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_grid" app:tint="#666666" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grid" android:textSize="12sp" android:textStyle="bold" android:textColor="#666666"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btnApplyToAll" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:gravity="center" android:paddingHorizontal="12dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apply to All" android:textSize="12sp" android:textStyle="bold" android:textColor="#666666"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/containerAlignmentSlider" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Alignment" android:textSize="10sp" android:textAllCaps="true" android:textColor="#888888"/>
                <TextView android:id="@+id/txtAlignmentVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Center" android:textSize="10sp" android:textColor="#333333"/>
            </LinearLayout>
            <SeekBar android:id="@+id/sliderAlignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="2" android:progress="1" android:thumbTint="#1E3C72" android:progressTint="#1E3C72" android:paddingStart="0dp" android:paddingEnd="0dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="4dp">
                <CheckBox android:id="@+id/chkAlignHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Header" android:textSize="10sp" android:textColor="#666666" android:checked="true" android:button="@drawable/selector_checkbox_circular" android:buttonTint="@null" app:buttonTint="@null" app:useMaterialThemeColors="false" android:layout_marginEnd="12dp" android:paddingStart="4dp"/>
                <CheckBox android:id="@+id/chkAlignItems" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Items" android:textSize="10sp" android:textColor="#666666" android:checked="false" android:button="@drawable/selector_checkbox_circular" android:buttonTint="@null" app:buttonTint="@null" app:useMaterialThemeColors="false" android:paddingStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/containerGridSpacing" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Grid Spacing" android:textSize="10sp" android:textAllCaps="true" android:textColor="#888888"/>
                <TextView android:id="@+id/txtGridSpacingVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0px" android:textSize="10sp" android:textColor="#333333"/>
            </LinearLayout>
            <SeekBar android:id="@+id/sliderGridSpacing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:max="60" android:progress="10" android:thumbTint="#1E3C72" android:progressTint="#1E3C72" android:paddingStart="0dp" android:paddingEnd="0dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:layout_marginHorizontal="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Item Customization" android:textSize="14sp" android:textColor="#666"/>
        <TextView android:id="@+id/btnSelectAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select All" android:textSize="12sp" android:textStyle="bold" android:textColor="#1E3C72" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#EEF2FF" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground"/>
    </LinearLayout>

    <!-- BOX 2: SUB-SECTION LIST with Floating Actions -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/subsectionContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="40dp">
                <!-- Items added programmatically here -->
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Multi-Select Floating Panel (Integrated look) -->
        <LinearLayout android:id="@+id/multiSelectPanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/pill_background" android:backgroundTint="#FFFFFF" android:padding="8dp" android:visibility="gone" android:elevation="12dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp" android:gravity="center_vertical">

            <!-- Multi-Select Controls Container -->
            <LinearLayout android:id="@+id/multiActionsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <!-- Shared Line Space -->
                <ImageView android:id="@+id/btnMultiLineSpace" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_line_spacing" android:background="@drawable/circle_shape" android:backgroundTint="#F0F4FF" app:tint="#1E3C72" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true"/>

                <!-- Shared Roundness -->
                <ImageView android:id="@+id/btnMultiRoundness" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_circle_half_filled" android:background="@drawable/circle_shape" android:backgroundTint="#F0F4FF" app:tint="#1E3C72" android:layout_marginEnd="12dp" android:clickable="true" android:focusable="true"/>

                <!-- Shared Color -->
                <FrameLayout android:id="@+id/btnMultiColor" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/circle_shape" android:backgroundTint="#F0F4FF" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_circle_colorful"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Shared Sliders (Hidden) -->
            <LinearLayout android:id="@+id/multiSlidersContainer" android:layout_width="120dp" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginStart="8dp">
                <TextView android:id="@+id/lblMultiSlider" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Value" android:textSize="10sp" android:textColor="#666"/>
                <SeekBar android:id="@+id/sliderMulti" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:thumbTint="#1E3C72" android:progressTint="#1E3C72" android:paddingStart="0dp" android:paddingEnd="0dp"/>
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
