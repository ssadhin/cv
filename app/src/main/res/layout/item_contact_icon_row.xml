<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:paddingHorizontal="4dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime">

    <!-- Icon Preview Container -->
    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@color/surface_card_nested" android:backgroundTint="@color/surface_card_nested" android:layout_marginEnd="12dp">

        <ImageView android:id="@+id/iv_icon_preview" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:scaleType="centerInside" />

        <!-- Small indicator for custom image -->
        <View android:id="@+id/custom_image_indicator" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|end" android:layout_margin="4dp" android:background="@android:color/holo_green_dark" android:visibility="gone" />
    </FrameLayout>

    <!-- Item Text (e.g. alex@gmail.com) -->
    <TextView android:id="@+id/tv_contact_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="alex@gmail.com" android:textColor="@color/text_primary" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="8dp" />

    <!-- Tint Button -->
    <ImageButton android:id="@+id/btn_item_tint" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_palette" android:padding="8dp" app:tint="@color/text_secondary" />

    <!-- Enlarge/Size Button -->
    <ImageButton android:id="@+id/btn_item_size" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_format_size" android:padding="8dp" app:tint="@color/text_secondary" />

</LinearLayout>
