<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/homeRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#f5f5f5" tools:context=".HomeActivity">

    <!-- Drop Zone for Share (Overlay) -->
    <LinearLayout android:id="@+id/shareDropZone" android:layout_width="0dp" android:layout_height="120dp" android:background="#E3F2FD" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:elevation="20dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_share" app:tint="#1976D2" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drop here to Share" android:textSize="18sp" android:textStyle="bold" android:textColor="#1976D2" android:layout_marginTop="8dp"/>
    </LinearLayout>



    <!-- Branding Header -->
    <LinearLayout android:id="@+id/brandingHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="48dp" android:paddingBottom="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <ImageView android:id="@+id/ivAppLogo" android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/cv" android:contentDescription="App Logo" />

        <TextView android:id="@+id/tvAppTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vitae" android:textColor="#1a237e" android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="8dp"/>

    </LinearLayout>

    <TextView android:id="@+id/tvRecentHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginStart="24dp" android:text="Recent" android:textColor="#424242" android:textSize="20sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/brandingHeader" />

    <TextView android:id="@+id/tvSortLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sorted by time edited" android:textColor="#757575" android:textSize="12sp" app:layout_constraintBottom_toBottomOf="@id/tvRecentHeader" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/tvRecentHeader" />

    <LinearLayout android:id="@+id/controlsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:gravity="center_vertical" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="@id/tvRecentHeader" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/tvRecentHeader">

        <SeekBar android:id="@+id/gridSizeSlider" android:layout_width="100dp" android:layout_height="wrap_content" android:max="3" android:progress="0" android:visibility="gone" />

        <ImageButton android:id="@+id/btnCloseSelection" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="#424242" android:visibility="gone" />

        <ImageButton android:id="@+id/btnDeleteSelected" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_delete" app:tint="#D32F2F" android:visibility="gone" tools:visibility="visible" />

        <ImageButton android:id="@+id/btnSort" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="8dp" android:src="@android:drawable/ic_menu_sort_alphabetically" app:tint="#424242" />

        <ImageButton android:id="@+id/btnToggleView" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_grid" app:tint="#424242" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecentResumes" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="16dp" android:clipToPadding="false" android:paddingBottom="88dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRecentHeader" />

    <TextView android:id="@+id/tvEmptyState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No recently worked on CVs" android:textColor="#9e9e9e" android:textSize="16sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRecentHeader" />

    <!-- FAB Options Panel -->
    <FrameLayout android:id="@+id/fabOptionsPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#CC000000" android:visibility="gone" android:elevation="20dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="24dp" android:layout_marginBottom="88dp" android:gravity="end" android:orientation="vertical">

            <!-- Option 4: AI Mode -->
            <LinearLayout android:id="@+id/optionAI" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Mode (Coming Soon)" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@android:drawable/ic_menu_view" app:tint="#757575" app:backgroundTint="#F5F5F5" />
            </LinearLayout>

            <!-- Option 3: Step by Step -->
            <LinearLayout android:id="@+id/optionStepByStep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Step by Step (Demo)" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@android:drawable/ic_menu_directions" app:tint="#757575" app:backgroundTint="#F5F5F5" />
            </LinearLayout>

            <!-- Option 2: Export/Import -->
            <LinearLayout android:id="@+id/optionExport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Import (.vitae)" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@android:drawable/ic_menu_share" app:tint="#757575" app:backgroundTint="#F5F5F5" />
            </LinearLayout>

            <!-- Option 1: New CV -->
            <LinearLayout android:id="@+id/optionNewCV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New CV" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@drawable/ic_add" app:tint="#757575" app:backgroundTint="#F5F5F5" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/home_fab_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <!-- Step by Step Wizard Button -->
        <FrameLayout android:id="@+id/btnHomeStepByStep" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginBottom="16dp" app:layout_constraintDimensionRatio="1:1" app:layout_constraintWidth_percent="0.135" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toTopOf="@id/btnHomeNewCV">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
            <ImageButton android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:layout_margin="8dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="false" android:focusable="false" android:contentDescription="Step by Step Wizard" android:scaleType="fitCenter" android:src="@drawable/ic_steps_plus_centered" app:tint="#1a237e" />
        </FrameLayout>

        <!-- New CV Button (+) -->
        <FrameLayout android:id="@+id/btnHomeNewCV" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintDimensionRatio="1:1" app:layout_constraintWidth_percent="0.135" app:layout_constraintTop_toBottomOf="@id/btnHomeStepByStep" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
            <ImageButton android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:layout_margin="8dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="false" android:contentDescription="Create New CV" android:scaleType="fitCenter" android:src="@drawable/ic_add" />
        </FrameLayout>

        <!-- AI Assistant Button (Left of Plus) -->
        <FrameLayout android:id="@+id/btnHomeAI" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginEnd="16dp" app:layout_constraintDimensionRatio="1:1" app:layout_constraintWidth_percent="0.135" app:layout_constraintBottom_toBottomOf="@id/btnHomeNewCV" app:layout_constraintEnd_toStartOf="@id/btnHomeNewCV" app:layout_constraintTop_toTopOf="@id/btnHomeNewCV">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
            <ImageButton android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:layout_margin="8dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="false" android:focusable="false" android:contentDescription="AI Assistant" android:scaleType="fitCenter" android:src="@android:drawable/ic_menu_view" app:tint="#1a237e" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Folder Expansion Animation Overlay -->
    <View android:id="@+id/folderRevealOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:visibility="invisible" android:elevation="25dp" />

    <!-- Advanced Drag Zones (Right Side) -->
    <LinearLayout android:id="@+id/advancedDragZones" android:layout_width="120dp" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:elevation="15dp" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/zoneMoveToHome" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#E3F2FD" android:gravity="center" android:orientation="vertical" android:padding="16dp">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_keyboard_return" app:tint="#1976D2" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Move to Home" android:textSize="12sp" android:textStyle="bold" android:textColor="#1976D2" android:gravity="center" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/zoneMoveToOtherGroup" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#BBDEFB" android:gravity="center" android:orientation="vertical" android:padding="16dp">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_description" app:tint="#1565C0" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Move to Other Group" android:textSize="12sp" android:textStyle="bold" android:textColor="#1565C0" android:gravity="center" android:layout_marginTop="8dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
