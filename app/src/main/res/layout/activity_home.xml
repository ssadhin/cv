<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/homeRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary" tools:context=".HomeActivity" android:clipChildren="false" android:clipToPadding="false">

    <!-- Drop Zone for Share (Overlay) -->
    <LinearLayout android:id="@+id/shareDropZone" android:layout_width="0dp" android:layout_height="120dp" android:background="@color/bg_card" android:gravity="center" android:orientation="vertical" android:visibility="gone" android:elevation="20dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_share" app:tint="@color/text_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/drop_here_to_share" android:textSize="18sp" android:textStyle="bold" android:textColor="#111111" android:layout_marginTop="8dp"/>
    </LinearLayout>



    <!-- Guidelines for Branding Header Spacing -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glHeaderTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.0" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glHeaderBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.20" />

    <!-- Branding Header -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/brandingHeader" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:background="@android:color/transparent" 
        android:clipChildren="false" 
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="@id/glHeaderTop" 
        app:layout_constraintBottom_toBottomOf="@id/glHeaderBottom" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton android:id="@+id/ivRestoreBrand" 
            android:layout_width="48dp" 
            android:layout_height="48dp" 
            android:layout_marginStart="16dp" 
            android:background="?attr/selectableItemBackgroundBorderless" 
            android:src="@android:drawable/ic_menu_revert" 
            android:visibility="gone" 
            app:tint="#8A8A8A" 
            app:layout_constraintStart_toStartOf="parent" 
            app:layout_constraintTop_toTopOf="@id/profileContainer" 
            app:layout_constraintBottom_toBottomOf="@id/profileContainer" />

        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/profileContainer" 
            android:layout_width="match_parent" 
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivAppLogo" 
                android:layout_width="0dp" 
                android:layout_height="0dp" 
                android:src="@drawable/cv" 
                android:contentDescription="@string/app_logo_desc" 
                android:clickable="true" 
                android:focusable="true" 
                android:background="?attr/selectableItemBackgroundBorderless" 
                app:layout_constraintHeight_percent="0.6"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintBottom_toTopOf="@+id/tvAppTitle"
                app:shapeAppearanceOverlay="@style/CircleAppearance" />

            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivUserProfile" 
                android:layout_width="0dp" 
                android:layout_height="0dp" 
                android:visibility="gone" 
                android:scaleType="centerCrop" 
                android:clickable="true" 
                android:focusable="true" 
                android:background="?attr/selectableItemBackgroundBorderless" 
                app:layout_constraintHeight_percent="0.6" 
                app:layout_constraintDimensionRatio="1:1" 
                app:layout_constraintTop_toTopOf="parent" 
                app:layout_constraintStart_toStartOf="parent" 
                app:layout_constraintEnd_toEndOf="parent" 
                app:layout_constraintBottom_toTopOf="@+id/tvAppTitle" 
                app:shapeAppearanceOverlay="@style/CircleAppearance" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/logoBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="ivAppLogo,ivUserProfile" />

            <androidx.appcompat.widget.AppCompatTextView 
                android:id="@+id/tvAppTitle" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="@string/app_name" 
                android:textColor="@color/fab_purple_main" 
                android:textSize="34sp" 
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="48sp"
                app:autoSizeStepGranularity="2sp"
                android:textStyle="bold" 
                android:fontFamily="@font/dancing_script" 
                android:gravity="center"
                android:maxLines="1"
                app:layout_constraintWidth_percent="0.6"
                app:layout_constraintTop_toBottomOf="@id/logoBarrier"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glRecentHeaderTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.21" />

    <androidx.appcompat.widget.AppCompatTextView 
        android:id="@+id/tvRecentHeader" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content" 
        android:text="@string/recent" 
        android:textColor="@color/fab_purple_main" 
        android:textSize="20sp" 
        android:textStyle="bold" 
        app:layout_constraintStart_toStartOf="parent" 
        app:layout_constraintTop_toTopOf="@id/glRecentHeaderTop" 
        app:layout_constraintHorizontal_bias="0.06"
        android:layout_marginStart="24dp"/>

    <!-- Grouped Sort Controls shifted left -->
    <LinearLayout android:id="@+id/sortControlsGroup" 
        android:layout_width="0dp" 
        android:layout_height="wrap_content" 
        android:orientation="horizontal" 
        android:gravity="center_vertical" 
        app:layout_constraintBottom_toBottomOf="@id/tvRecentHeader" 
        app:layout_constraintTop_toTopOf="@id/tvRecentHeader" 
        app:layout_constraintStart_toEndOf="@id/tvRecentHeader" 
        app:layout_constraintEnd_toStartOf="@+id/controlsContainer" 
        app:layout_constraintHorizontal_bias="0.2"
        app:layout_constraintWidth_percent="0.32">

        <ImageButton android:id="@+id/btnSort" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless" 
            android:padding="6dp" 
            android:src="@android:drawable/ic_menu_sort_alphabetically" 
            app:tint="@color/fab_purple_main" />

        <androidx.appcompat.widget.AppCompatTextView 
            android:id="@+id/tvSortLabel" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="3"
            android:layout_marginStart="4dp" 
            android:text="@string/sorted_by_time_edited" 
            android:textColor="#8A5CD4" 
            android:textSize="11sp" 
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeMaxTextSize="12sp"
            android:maxLines="1"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/controlsContainer" 
        android:layout_width="0dp" 
        android:layout_height="wrap_content" 
        app:layout_constraintBottom_toBottomOf="@id/tvRecentHeader" 
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd" 
        app:layout_constraintTop_toTopOf="@id/tvRecentHeader"
        app:layout_constraintWidth_percent="0.4">

        <SeekBar android:id="@+id/gridSizeSlider" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:max="3" 
            android:progress="0" 
            android:visibility="gone" 
            android:progressDrawable="@drawable/bg_neumorphic_slider_track" 
            android:thumb="@drawable/bg_neumorphic_slider_thumb" 
            android:splitTrack="false" 
            android:minHeight="6dp" 
            android:maxHeight="6dp"
            app:layout_constraintEnd_toStartOf="@+id/btnCloseSelection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton android:id="@+id/btnCloseSelection" 
            android:layout_width="0dp" 
            android:layout_height="0dp" 
            android:background="?attr/selectableItemBackgroundBorderless" 
            android:src="@android:drawable/ic_menu_close_clear_cancel" 
            app:tint="@color/text_primary" 
            android:visibility="gone"
            app:layout_constraintWidth_percent="0.2"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteSelected"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton android:id="@+id/btnDeleteSelected" 
            android:layout_width="0dp" 
            android:layout_height="0dp" 
            android:background="?attr/selectableItemBackgroundBorderless" 
            android:src="@android:drawable/ic_menu_delete" 
            app:tint="#D32F2F" 
            android:visibility="gone" 
            tools:visibility="visible"
            app:layout_constraintWidth_percent="0.2"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/btnToggleView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton android:id="@+id/btnToggleView" 
            android:layout_width="0dp" 
            android:layout_height="0dp" 
            android:background="?attr/selectableItemBackgroundBorderless" 
            android:src="@drawable/ic_grid" 
            app:tint="@color/fab_purple_main"
            app:layout_constraintWidth_percent="0.2"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecentResumes" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="16dp" android:clipToPadding="false" android:paddingBottom="8dp" app:layout_constraintBottom_toTopOf="@id/adView" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRecentHeader" />

    <TextView android:id="@+id/tvEmptyState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_recent_cvs" android:textColor="#333333" android:textSize="16sp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvRecentHeader" />

    <!-- FAB Options Panel -->
    <FrameLayout android:id="@+id/fabOptionsPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#CC000000" android:visibility="gone" android:elevation="20dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_marginEnd="24dp" android:layout_marginBottom="88dp" android:gravity="end" android:orientation="vertical">

            <!-- Option 4: AI Mode -->
            <LinearLayout android:id="@+id/optionAI" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_mode" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@drawable/ic_ai_custom" app:tint="@color/text_secondary" app:backgroundTint="@color/bg_button" android:stateListAnimator="@animator/wobbly_slime" />
            </LinearLayout>

            <!-- Option 3: Step by Step -->
            <LinearLayout android:id="@+id/optionStepByStep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_by_step_demo" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@drawable/ic_step_by_step_wizard" app:tint="@color/text_secondary" app:backgroundTint="@color/bg_button" android:stateListAnimator="@animator/wobbly_slime" />
            </LinearLayout>

            <!-- Option 2: Export/Import -->
            <LinearLayout android:id="@+id/optionExport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/import_career_compass" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@android:drawable/ic_menu_share" app:tint="@color/text_secondary" app:backgroundTint="@color/bg_button" android:stateListAnimator="@animator/wobbly_slime" />
            </LinearLayout>

            <!-- Option 1: New CV -->
            <LinearLayout android:id="@+id/optionNewCV" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/new_cv" android:textColor="#FFFFFF" android:layout_marginEnd="12dp" android:textStyle="bold" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:layout_width="wrap_content" android:layout_height="wrap_content" app:fabSize="normal" android:src="@drawable/ic_add" app:tint="@color/text_secondary" app:backgroundTint="@color/bg_button" android:stateListAnimator="@animator/wobbly_slime" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- Guidelines for Percentage Positioning -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStepByStepBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.82" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineAIBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.895" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineNewCVBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98" />

    <!-- 1. Step-by-Step Button -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnHomeStepByStep" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:background="@drawable/pill_with_shadow" 
        android:clickable="true" 
        android:focusable="true" 
        android:foreground="@drawable/ripple_pill" 
        android:stateListAnimator="@animator/wobbly_slime" 
        android:outlineProvider="background" 
        app:layout_constraintBottom_toTopOf="@id/guidelineStepByStepBottom" 
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd" 
        app:layout_constraintWidth_percent="0.33" 
        app:layout_constraintDimensionRatio="2:1" 
        android:hapticFeedbackEnabled="true"
        android:paddingStart="16dp" 
        android:paddingEnd="12dp">

        <androidx.appcompat.widget.AppCompatTextView 
            android:id="@+id/tvStepLabel"
            android:layout_width="0dp" 
            android:layout_height="0dp"
            android:gravity="center_vertical|start"
            android:text="@string/step_by_step_mode" 
            android:textColor="@color/fab_text_dark" 
            android:textSize="14sp" 
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeMaxTextSize="15sp"
            android:textStyle="bold" 
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.55"
            app:layout_constraintHorizontal_bias="0.0"/>

        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/circleBgStep"
            android:layout_width="0dp" 
            android:layout_height="0dp" 
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.65"
            android:background="@drawable/purple_circle_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView android:id="@+id/ivStepIcon"
                android:layout_width="0dp" 
                android:layout_height="0dp" 
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.5"
                android:src="@drawable/ic_stairs" 
                app:tint="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. AI Helper Button -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/btnHomeAI" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:background="@drawable/pill_with_shadow" 
        android:clickable="true" 
        android:focusable="true" 
        android:foreground="@drawable/ripple_pill" 
        android:stateListAnimator="@animator/wobbly_slime" 
        android:outlineProvider="background" 
        app:layout_constraintBottom_toTopOf="@id/guidelineAIBottom" 
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd" 
        app:layout_constraintWidth_percent="0.28" 
        app:layout_constraintDimensionRatio="1.8:1" 
        android:hapticFeedbackEnabled="true"
        android:paddingStart="16dp" 
        android:paddingEnd="12dp">

        <androidx.appcompat.widget.AppCompatTextView 
            android:id="@+id/tvAILabel"
            android:layout_width="0dp" 
            android:layout_height="0dp"
            android:gravity="center_vertical|start"
            android:text="@string/ai_helper" 
            android:textColor="@color/fab_text_dark" 
            android:textSize="14sp" 
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="7sp"
            app:autoSizeMaxTextSize="15sp"
            android:textStyle="bold" 
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.55"
            app:layout_constraintHorizontal_bias="0.5"/>

        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/circleBgAI"
            android:layout_width="0dp" 
            android:layout_height="0dp" 
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.65"
            android:background="@drawable/purple_circle_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView android:id="@+id/ivAIIcon"
                android:layout_width="0dp" 
                android:layout_height="0dp" 
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.5"
                android:src="@drawable/ic_sparkles_premium" 
                app:tint="@color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. New CV Button -->
    <FrameLayout android:id="@+id/btnHomeNewCV" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:background="@drawable/circle_with_shadow" 
        android:clickable="true" 
        android:focusable="true" 
        android:foreground="@drawable/ripple_circle" 
        android:stateListAnimator="@animator/wobbly_slime" 
        android:outlineProvider="background" 
        app:layout_constraintBottom_toTopOf="@id/guidelineNewCVBottom" 
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd" 
        app:layout_constraintWidth_percent="0.18" 
        app:layout_constraintDimensionRatio="1:1" 
        android:hapticFeedbackEnabled="true">

        <ImageView android:layout_width="match_parent" 
            android:layout_height="match_parent" 
            android:layout_gravity="center" 
            android:padding="12dp"
            android:src="@drawable/ic_add_bold" 
            app:tint="@color/white" />
    </FrameLayout>

    <!-- AdMob Banner -->
    <com.google.android.gms.ads.AdView android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        android:background="@android:color/transparent"
        app:adSize="BANNER"
        app:adUnitId="@string/ad_unit_id_banner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Folder Expansion Animation Overlay -->
    <View android:id="@+id/folderRevealOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary" android:visibility="invisible" android:elevation="25dp" />

    <!-- Advanced Drag Zones (Right Side) -->
    <LinearLayout android:id="@+id/advancedDragZones" android:layout_width="120dp" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:elevation="15dp" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/zoneMoveToHome" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/bg_card" android:gravity="center" android:orientation="vertical" android:padding="16dp">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_keyboard_return" app:tint="@color/text_primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/move_to_home" android:textSize="12sp" android:textStyle="bold" android:textColor="#111111" android:gravity="center" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/zoneMoveToOtherGroup" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/bg_button" android:gravity="center" android:orientation="vertical" android:padding="16dp">
            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_description" app:tint="@color/text_secondary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/move_to_other_group" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" android:gravity="center" android:layout_marginTop="8dp"/>
        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
