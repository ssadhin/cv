<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">


        <!-- Section Designs -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Section Style" android:textStyle="bold" android:textSize="14sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#F5F5F5" android:padding="4dp" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btn_section_prev" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_left" android:background="?attr/selectableItemBackgroundBorderless"/>

            <ViewFlipper android:id="@+id/flipper_section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inAnimation="@android:anim/slide_in_left" android:outAnimation="@android:anim/slide_out_right">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/txt_section_choice_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Classic" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp" android:background="@drawable/shape_active_choice"/>
                    <TextView android:id="@+id/txt_section_choice_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Timeline" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/txt_section_choice_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Glass" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp"/>
                    <TextView android:id="@+id/txt_section_choice_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bento" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp"/>
                </LinearLayout>
            </ViewFlipper>

            <ImageButton android:id="@+id/btn_section_next" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_right" android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <!-- Progress Designs -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Progress Style" android:textStyle="bold" android:textSize="14sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#F5F5F5" android:padding="4dp" android:layout_marginBottom="16dp">
            <ImageButton android:id="@+id/btn_progress_prev" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_left" android:background="?attr/selectableItemBackgroundBorderless"/>

            <ViewFlipper android:id="@+id/flipper_progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inAnimation="@android:anim/slide_in_left" android:outAnimation="@android:anim/slide_out_right">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/txt_progress_choice_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bar" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp" android:background="@drawable/shape_active_choice"/>
                    <TextView android:id="@+id/txt_progress_choice_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Circle" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/txt_progress_choice_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Plain" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp"/>
                    <View android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>
            </ViewFlipper>

            <ImageButton android:id="@+id/btn_progress_next" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_right" android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <!-- Designer Column (Left/Right) -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Designer Column" android:textStyle="bold" android:textSize="14sp" android:textColor="#000000" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#F5F5F5" android:padding="12dp" android:layout_marginBottom="16dp">

            <!-- Layout Mode: Default vs Mirror -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LAYOUT MODE" android:textSize="10sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <ImageButton android:id="@+id/btn_layout_prev" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_left" android:background="?attr/selectableItemBackgroundBorderless"/>

                <ViewFlipper android:id="@+id/flipper_layout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:inAnimation="@android:anim/slide_in_left" android:outAnimation="@android:anim/slide_out_right">
                    <TextView android:id="@+id/txt_layout_choice_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Default (Left)" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp" android:background="@drawable/shape_active_choice"/>
                    <TextView android:id="@+id/txt_layout_choice_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mirror (Right)" android:textAlignment="center" android:padding="8dp" android:textSize="11sp" android:textStyle="bold" android:layout_margin="2dp"/>
                </ViewFlipper>

                <ImageButton android:id="@+id/btn_layout_next" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_right" android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <Button android:id="@+id/btn_left_col_bg" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Column Background Color" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.AppCompat.Button.Colored"/>

            <Button android:id="@+id/btn_left_frame_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Frame Border Color" android:textAllCaps="false" android:layout_marginBottom="12dp" style="@style/Widget.AppCompat.Button.Colored"/>

            <!-- Frame Thickness -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FRAME THICKNESS" android:textSize="10sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="4dp"/>
            <SeekBar android:id="@+id/seek_left_frame_thickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30" android:progress="0" android:layout_marginBottom="12dp"/>

            <!-- Corner Radius -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CORNER RADIUS" android:textSize="10sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="4dp"/>
            <SeekBar android:id="@+id/seek_left_col_radius" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" android:progress="0"/>

        </LinearLayout>

        <!-- Background Customization -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Page Background" android:textStyle="bold" android:textSize="14sp" android:textColor="#000000" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#F5F5F5" android:padding="12dp">

            <Button android:id="@+id/btn_bg_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set Background Color" android:textAllCaps="false" android:layout_marginBottom="12dp" style="@style/Widget.AppCompat.Button.Colored"/>

            <Button android:id="@+id/btn_bg_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Upload Background Image" android:textAllCaps="false" android:layout_marginBottom="16dp" style="@style/Widget.AppCompat.Button.Colored"/>

            <!-- Transparency Slider -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="IMAGE TRANSPARENCY" android:textSize="10sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="4dp"/>
            <SeekBar android:id="@+id/seek_bg_opacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="100" android:layout_marginBottom="16dp"/>

            <!-- Grayscale Slider -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GRAYSCALE (B&amp;W FILTER)" android:textSize="10sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="4dp"/>
            <SeekBar android:id="@+id/seek_bg_grayscale" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="0" android:layout_marginBottom="16dp"/>

            <!-- Column Transparency -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PANEL TRANSPARENCY" android:textSize="10sp" android:textStyle="bold" android:textColor="#666666" android:layout_marginBottom="4dp"/>
            <SeekBar android:id="@+id/seek_col_opacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="100"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
