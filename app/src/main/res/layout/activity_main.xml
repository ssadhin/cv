<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/root_container" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_primary" tools:context=".MainActivity" android:clipChildren="false" android:clipToPadding="false">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glTopBuffer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <!-- WebView fills the area below the top buffer -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/glSafeStart"
        app:layout_constraintTop_toTopOf="@id/glTopBuffer" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/glSafeStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.05" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/glSafeEnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.95" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/glSafeBottom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="1.0" />

    <!-- Guidelines for Side Panel Height Limits (Centered 64.6% area) -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/panel_limit_top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.20" />
    <androidx.constraintlayout.widget.Guideline android:id="@+id/panel_limit_bottom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.80" />

    <include layout="@layout/partial_side_panel_left" />

    <!-- Collapsible Side Panel Right -->
    <include layout="@layout/partial_side_panel_right" />

    <!-- Show Panel Button (Initially Hidden) -->
    <FrameLayout android:id="@+id/show_button_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="16dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

        <ImageButton android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@android:color/transparent" android:clickable="false" android:scaleType="fitCenter" android:src="@drawable/ic_unhide" />
    </FrameLayout>

    <!-- Show Panel Button Right (Initially Hidden) -->
    <FrameLayout android:id="@+id/show_button_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="16dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">

        <ImageButton android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:background="@android:color/transparent" android:clickable="false" android:scaleType="fitCenter" android:src="@drawable/ic_unhide" />
    </FrameLayout>



    <LinearLayout android:id="@+id/undo_redo_container" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="16dp" android:layout_marginBottom="16dp" android:orientation="horizontal" app:layout_constraintWidth_percent="0.26" app:layout_constraintHeight_percent="0.053" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" android:clipChildren="false" android:clipToPadding="false">

        <FrameLayout android:id="@+id/fab_undo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="16dp" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime">

            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />

            <ImageButton android:id="@+id/fab_undo_btn" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="@string/undo" android:scaleType="fitCenter" android:src="@drawable/undo" />

        </FrameLayout>

        <FrameLayout android:id="@+id/fab_redo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime">

            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />

            <ImageButton android:id="@+id/fab_redo_btn" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="@string/redo" android:scaleType="fitCenter" android:src="@drawable/redo" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout android:id="@+id/add_edit_container" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" android:gravity="end" android:orientation="vertical" app:layout_constraintWidth_percent="0.135" app:layout_constraintDimensionRatio="1:4.5" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" android:clipChildren="false" android:clipToPadding="false">
  
        <FrameLayout android:id="@+id/fab_ai" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime" android:hapticFeedbackEnabled="true">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
            <ImageButton android:id="@+id/btn_ai" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:layout_margin="6dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="false" android:contentDescription="@string/ai_assistant" android:scaleType="fitCenter" android:src="@drawable/ic_ai_custom" />
        </FrameLayout>

        <FrameLayout android:id="@+id/fab_wizard" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="16dp" android:visibility="visible" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime" android:hapticFeedbackEnabled="true">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
            <ImageButton android:id="@+id/btn_wizard" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:layout_margin="8dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="false" android:focusable="false" android:contentDescription="@string/step_by_step_wizard_desc" android:scaleType="fitCenter" android:src="@drawable/ic_step_by_step_wizard" />
        </FrameLayout>

        <FrameLayout android:id="@+id/fab_edit" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime" android:hapticFeedbackEnabled="true">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
            <ImageButton android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:layout_margin="6dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="false" android:contentDescription="@string/edit" android:scaleType="fitCenter" android:src="@drawable/edit" />
        </FrameLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false">

            <FrameLayout android:id="@+id/print_fab" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime" android:hapticFeedbackEnabled="true">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
                <ImageButton android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@android:color/transparent" android:clickable="false" android:contentDescription="@string/print" android:scaleType="fitCenter" android:src="@drawable/print" />
            </FrameLayout>

            <FrameLayout android:id="@+id/fab_add" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:clickable="true" android:focusable="true" android:stateListAnimator="@animator/wobbly_slime" android:hapticFeedbackEnabled="true">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@drawable/custom_shadow" />
                <ImageButton android:id="@+id/fab_add_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:background="@android:color/transparent" android:clickable="false" android:contentDescription="@string/add_features" android:scaleType="fitCenter" android:src="@drawable/ic_add" />
            </FrameLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- Universal Toolbar Container -->
    <androidx.cardview.widget.CardView android:id="@+id/universal_toolbar_container" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:visibility="gone" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="40dp" app:cardElevation="8dp" app:layout_constraintWidth_percent="0.13" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">

        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:animateLayoutChanges="true">

            <!-- Single Unified Content Panel -->
            <LinearLayout android:id="@+id/unified_content_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingVertical="8dp">

                <!-- Formatting Group (Text Selection) -->
                <LinearLayout android:id="@+id/group_formatting" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <include android:id="@+id/btn_bold" layout="@layout/panel_button_selection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <include android:id="@+id/btn_italic" layout="@layout/panel_button_selection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <include android:id="@+id/btn_underline" layout="@layout/panel_button_selection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <include android:id="@+id/btn_strike" layout="@layout/panel_button_selection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <include android:id="@+id/btn_highlight" layout="@layout/panel_button_selection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />
                    <!-- Separator? -->

                </LinearLayout>

                <!-- Actions Group (Add, Copy, Edit, Swap, Upload) -->
                <include android:id="@+id/btn_add" layout="@layout/panel_button" android:visibility="gone"/>
                <include android:id="@+id/btn_copy" layout="@layout/panel_button" android:visibility="gone"/>
                <include android:id="@+id/btn_edit" layout="@layout/panel_button" android:visibility="gone"/>
                <include android:id="@+id/btn_swap" layout="@layout/panel_button" android:visibility="gone"/>
                <include android:id="@+id/btn_upload" layout="@layout/panel_button" android:visibility="gone"/>

                <!-- Navigation Group (Up/Down) -->
                <include android:id="@+id/btn_up" layout="@layout/panel_button" android:visibility="gone"/>
                <include android:id="@+id/btn_down" layout="@layout/panel_button" android:visibility="gone"/>

                <!-- Destructive Group (Delete) -->
                <include android:id="@+id/btn_delete" layout="@layout/panel_button" android:visibility="gone"/>

            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>



    <SeekBar android:id="@+id/precise_column_width_slider" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="96dp" android:layout_marginEnd="96dp" android:max="100" android:progress="50" android:progressDrawable="@android:color/transparent" android:thumb="@drawable/slider_thumb_large" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <SeekBar android:id="@+id/precise_zoom_slider" android:layout_width="0dp" android:layout_height="112dp" android:max="100" android:progress="15" android:progressDrawable="@android:color/transparent" android:rotation="270" android:thumb="@drawable/slider_thumb_large" android:splitTrack="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone" app:layout_constraintWidth_percent="0.646" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/precise_zoom_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45%" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <SeekBar android:id="@+id/precise_font_size_slider" android:layout_width="0dp" android:layout_height="112dp" android:max="14" android:progress="4" android:progressDrawable="@android:color/transparent" android:rotation="270" android:thumb="@drawable/slider_thumb_large" android:splitTrack="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone" app:layout_constraintWidth_percent="0.646" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/precise_font_size_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12pt" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <SeekBar android:id="@+id/precise_line_spacing_slider" android:layout_width="0dp" android:layout_height="112dp" android:max="99" android:progress="49" android:progressDrawable="@android:color/transparent" android:rotation="270" android:thumb="@drawable/slider_thumb_large" android:splitTrack="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone" app:layout_constraintWidth_percent="0.646" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/precise_line_spacing_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <SeekBar android:id="@+id/precise_in_column_spacing_slider" android:layout_width="0dp" android:layout_height="112dp" android:max="99" android:progress="49" android:progressDrawable="@android:color/transparent" android:rotation="270" android:thumb="@drawable/slider_thumb_large" android:splitTrack="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone" app:layout_constraintWidth_percent="0.646" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/precise_in_column_spacing_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <SeekBar android:id="@+id/precise_out_column_spacing_slider" android:layout_width="0dp" android:layout_height="112dp" android:max="99" android:progress="49" android:progressDrawable="@android:color/transparent" android:rotation="270" android:thumb="@drawable/slider_thumb_large" android:splitTrack="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone" app:layout_constraintWidth_percent="0.646" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/precise_out_column_spacing_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <SeekBar android:id="@+id/precise_photo_radius_slider" android:layout_width="0dp" android:layout_height="112dp" android:max="60" android:progress="0" android:progressDrawable="@android:color/transparent" android:rotation="270" android:thumb="@drawable/slider_thumb_large" android:splitTrack="false" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone" app:layout_constraintWidth_percent="0.646" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/precise_photo_radius_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />






    <!-- ATS Badge (Native Circle) -->
    <androidx.cardview.widget.CardView android:id="@+id/ats_badge" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="32dp" android:visibility="gone" app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="24dp" app:cardElevation="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:stateListAnimator="@animator/wobbly_slime">

        <TextView android:id="@+id/ats_badge_score" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/circular_button_background" />
    </androidx.cardview.widget.CardView>

    <!-- CV Name Display -->
    <TextView android:id="@+id/cv_name_display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/pill_background_frosted" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:text="@string/untitled_cv" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:elevation="6dp" android:visibility="visible" android:clickable="false" android:focusable="false" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@+id/undo_redo_container" app:layout_constraintEnd_toStartOf="@+id/add_edit_container" />

    <!-- ATS Hub Panel (Hidden Overlay) -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/ats_hub_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" android:visibility="gone" android:clickable="true" android:focusable="true" android:clipChildren="false" android:clipToPadding="false">

        <androidx.cardview.widget.CardView android:id="@+id/ats_hub_panel" android:layout_width="0dp" android:layout_height="0dp" app:cardCornerRadius="24dp" app:cardElevation="12dp" app:layout_constraintWidth_percent="0.9" app:layout_constraintHeight_percent="0.8" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:clipChildren="false" android:clipToPadding="false">

            <include layout="@layout/dialog_ats_hub" />

        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Native Add Feature Panel -->
    <androidx.cardview.widget.CardView android:id="@+id/add_feature_panel" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginBottom="100dp" android:visibility="gone" app:cardBackgroundColor="#B0BDBDBD" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:layout_constraintHeight_percent="0.5" app:layout_constraintWidth_percent="0.95" app:layout_constraintVertical_bias="1.0" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" android:clipChildren="false" android:clipToPadding="false">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@android:color/transparent" android:clipChildren="false" android:clipToPadding="false">

            <com.google.android.material.tabs.TabLayout android:id="@+id/panel_tab_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" app:tabMode="fixed" app:tabGravity="fill" app:tabIndicatorColor="@color/brand_primary" app:tabSelectedTextColor="@color/text_primary" app:tabTextColor="@color/text_secondary"/>

            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/panel_view_pager" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!-- Template Selection Mode UI -->
    <include android:id="@+id/template_info_panel" layout="@layout/template_info_panel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintWidth_percent="0.9" />

    <include android:id="@+id/template_selection_controls" layout="@layout/template_selection_controls" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginBottom="32dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintWidth_percent="0.9" />

    <include android:id="@+id/btn_template_info_minimized" layout="@layout/template_info_panel" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginBottom="100dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <!-- Step-by-Step Wizard Panel (Hidden Overlay) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wizard_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header -->
        <RelativeLayout android:id="@+id/wizard_header" android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/bg_card" android:paddingHorizontal="16dp" app:layout_constraintTop_toTopOf="parent" android:elevation="4dp">
            <ImageButton android:id="@+id/wizard_btnClose" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" app:tint="@color/text_primary" />
            <TextView android:id="@+id/wizard_tvStepTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="@string/select_purpose" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="LIVE PREVIEW" android:textColor="@color/brand_primary" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" />
        </RelativeLayout>

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/wizard_progressBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="3" android:progress="1" app:layout_constraintTop_toBottomOf="@id/wizard_header" app:trackColor="@color/divider_color" app:indicatorColor="@color/text_primary" />

        <!-- ViewPager2 for Steps (Bottom) - FLOATING OVERLAY STYLE -->
        <androidx.cardview.widget.CardView android:id="@+id/wizard_cardSteps" android:layout_width="match_parent" android:layout_height="0dp" app:cardCornerRadius="24dp" app:cardElevation="12dp" app:cardBackgroundColor="@color/bg_primary" android:layout_marginHorizontal="16dp" android:layout_marginBottom="24dp" app:layout_constraintHeight_percent="0.45" app:layout_constraintBottom_toBottomOf="parent" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingBottom="16dp">
                
                <!-- DRAG HANDLE (24dp hit area) -->
                <FrameLayout
                    android:id="@+id/wizard_drag_handle"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="#08000000"
                    android:clickable="true"
                    android:focusable="true">
                    
                    <View
                        android:layout_width="64dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_drag_handle_pill" />
                </FrameLayout>
                
                <androidx.viewpager2.widget.ViewPager2 android:id="@+id/wizard_viewPager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
                <!-- Footer inside the card -->
                <LinearLayout android:id="@+id/wizard_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="8dp">
                    <Button android:id="@+id/wizard_btnBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/back" android:visibility="gone" android:textColor="@color/text_secondary" app:cornerRadius="24dp"/>
                    <View android:id="@+id/wizard_footerSpacer" android:layout_width="16dp" android:layout_height="0dp" android:visibility="gone"/>
                    <Button android:id="@+id/wizard_btnNext" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="@color/brand_primary" android:text="@string/next" android:textColor="@color/white" app:cornerRadius="24dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- AdMob Banner -->
    <!-- AdMob Banner -->
    <com.google.android.gms.ads.AdView android:id="@+id/adViewMain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:background="@android:color/transparent" app:adSize="BANNER" app:adUnitId="@string/ad_unit_id_banner" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <!-- On-Screen Debug Console (Visible for debugging) -->
    <ScrollView
        android:id="@+id/debug_console_scroll"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_margin="16dp"
        android:background="#A0000000"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/cv_name_display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        
        <TextView
            android:id="@+id/debug_console_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Debug Console Ready...\n"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="10sp" />
    </ScrollView>

    <!-- Native Debug System (Floating Overlay) -->
    <!-- Floating Ball (Minimizer) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/debug_ball"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="25dp"
        app:cardElevation="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:stateListAnimator="@animator/wobbly_slime"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings"
            app:tint="#FFFFFF" />
    </androidx.cardview.widget.CardView>

    <!-- Tabbed Debug Panel (Full Overlay) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/debug_native_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F0F8FF"
        app:cardCornerRadius="20dp"
        app:cardElevation="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/debug_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicatorColor="#2196F3"
                app:tabSelectedTextColor="#2196F3"
                app:tabTextColor="#666666">
                <!-- Tabs will be added via Java -->
            </com.google.android.material.tabs.TabLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp">
                
                <TextView
                    android:id="@+id/debug_log_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Select a category to see logs..."
                    android:textColor="#333333"
                    android:textSize="11sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="end">
                
                <Button
                    android:id="@+id/btn_debug_clear"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="#F44336" />

                <Button
                    android:id="@+id/btn_debug_copy"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy"
                    android:textColor="#2196F3" />

                <Button
                    android:id="@+id/btn_debug_close"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Close"
                    android:textColor="#333333" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

