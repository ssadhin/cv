<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/step3Container" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:visibility="gone">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/final_step" android:textColor="@color/text_secondary" android:textSize="14sp" android:letterSpacing="0.05" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_3_of_3" android:textColor="@color/brand_primary" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:fontFamily="sans-serif-black" android:text="@string/ai_step_3_title" android:textColor="@color/text_primary" android:textSize="32sp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ai_step_3_desc" android:textColor="@color/text_secondary" android:textSize="17sp" android:lineSpacingExtra="4dp" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="320dp" android:layout_marginTop="32dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_card_nested" app:strokeColor="@color/divider_color_new" app:strokeWidth="1dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp">
            <EditText android:id="@+id/etManualJsonInput" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:gravity="top|start" android:hint="@string/paste_ai_cv_hint" android:textColorHint="@color/text_secondary" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textMultiLine"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/btnClearInput" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear" android:textColor="@color/accent_red" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:clickable="true" android:focusable="true" android:layout_marginEnd="12dp" android:background="?attr/selectableItemBackgroundBorderless" android:stateListAnimator="@animator/wobbly_slime"/>
                <TextView android:id="@+id/btnPasteIntoInput" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paste" android:textColor="@color/brand_primary" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless" android:stateListAnimator="@animator/wobbly_slime"/>
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton android:id="@+id/btnGenerateFinal" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginBottom="16dp" android:text="@string/ai_generate_cv" android:textAllCaps="false" android:textSize="18sp" android:textStyle="bold" app:cornerRadius="24dp" app:backgroundTint="@color/brand_primary" android:textColor="#FFFFFF" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_lock_lock" app:tint="@color/text_secondary"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/ai_footer_lock" android:textColor="@color/text_secondary" android:textSize="13sp" />
    </LinearLayout>

    <TextView android:id="@+id/btnBackToStep2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="24dp" android:text="@string/back_to_step_2" android:textColor="@color/text_secondary" android:textSize="15sp" android:textStyle="bold" android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>

</LinearLayout>
