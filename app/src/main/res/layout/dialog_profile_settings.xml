<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surface_dialog">

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">

            <View android:id="@+id/dialog_handle" android:layout_width="40dp" android:layout_height="4dp" android:layout_marginBottom="16dp" android:background="@color/divider_color_new" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView 
                android:id="@+id/dialog_title"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="@string/profile_settings_title" 
                android:textSize="20sp" 
                android:textStyle="bold" 
                android:textColor="@color/text_primary" 
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/dialog_handle" 
                app:layout_constraintStart_toStartOf="parent" 
                app:layout_constraintEnd_toEndOf="parent"
                app:autoSizeTextType="uniform"
                app:autoSizeMaxTextSize="24sp"
                app:autoSizeMinTextSize="14sp"
                android:maxLines="1" />

            <!-- Mode Toggle -->
            <com.google.android.material.button.MaterialButtonToggleGroup 
                android:id="@+id/toggle_group_shape" 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="24dp"
                app:singleSelection="true" 
                app:selectionRequired="true"
                app:layout_constraintTop_toBottomOf="@id/dialog_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <Button android:id="@+id/btn_mode_smooth" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shape_mode_smooth" />
                <Button android:id="@+id/btn_mode_polygon" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shape_mode_polygon" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Radius/Sides Slider Row -->
            <TextView android:id="@+id/txt_slider_label" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="@string/radius" 
                android:textColor="@color/text_secondary" 
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/toggle_group_shape"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.25" />

            <SeekBar android:id="@+id/slider_radius" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:max="60" 
                android:thumbTint="@color/brand_primary" 
                android:progressTint="@color/brand_primary" 
                app:layout_constraintTop_toTopOf="@id/txt_slider_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_slider_label"
                app:layout_constraintStart_toEndOf="@id/txt_slider_label"
                app:layout_constraintEnd_toStartOf="@+id/layout_val_radius" />

            <LinearLayout android:id="@+id/layout_val_radius"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:orientation="vertical" 
                android:gravity="end"
                app:layout_constraintTop_toTopOf="@id/txt_slider_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_slider_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.15">
                <TextView android:id="@+id/txt_radius_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textStyle="bold" />
                <TextView android:id="@+id/txt_shape_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="10sp" android:textColor="@color/text_secondary" android:visibility="gone" />
            </LinearLayout>

            <!-- Width Slider Row -->
            <TextView android:id="@+id/txt_width_label"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="@string/width" 
                android:textColor="@color/text_secondary" 
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                app:layout_constraintTop_toBottomOf="@id/txt_slider_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.25" />

            <SeekBar android:id="@+id/slider_width" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:max="700" 
                android:progress="120" 
                android:thumbTint="@color/brand_primary" 
                android:progressTint="@color/brand_primary" 
                app:layout_constraintTop_toTopOf="@id/txt_width_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_width_label"
                app:layout_constraintStart_toEndOf="@id/txt_width_label"
                app:layout_constraintEnd_toStartOf="@+id/layout_val_width" />

            <FrameLayout android:id="@+id/layout_val_width"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                app:layout_constraintTop_toTopOf="@id/txt_width_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_width_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.15">
                <TextView android:id="@+id/txt_width_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="120" android:gravity="end" android:textColor="@color/text_primary" android:textStyle="bold" />
                <EditText android:id="@+id/input_width_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="120" android:gravity="center" android:textColor="@color/text_primary" android:textStyle="bold" android:padding="4dp" android:background="@drawable/edit_text_bg" android:visibility="gone" android:maxLength="3" />
            </FrameLayout>

            <!-- Height Slider Row -->
            <TextView android:id="@+id/txt_height_label"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="@string/height" 
                android:textColor="@color/text_secondary" 
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                app:layout_constraintTop_toBottomOf="@id/txt_width_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.25" />

            <SeekBar android:id="@+id/slider_height" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:max="700" 
                android:progress="120" 
                android:thumbTint="@color/brand_primary" 
                android:progressTint="@color/brand_primary" 
                app:layout_constraintTop_toTopOf="@id/txt_height_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_height_label"
                app:layout_constraintStart_toEndOf="@id/txt_height_label"
                app:layout_constraintEnd_toStartOf="@+id/layout_val_height" />

            <FrameLayout android:id="@+id/layout_val_height"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                app:layout_constraintTop_toTopOf="@id/txt_height_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_height_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.15">
                <TextView android:id="@+id/txt_height_val" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="120" android:gravity="end" android:textColor="@color/text_primary" android:textStyle="bold" />
                <EditText android:id="@+id/input_height_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="120" android:gravity="center" android:textColor="@color/text_primary" android:textStyle="bold" android:padding="4dp" android:background="@drawable/edit_text_bg" android:visibility="gone" android:maxLength="3" />
            </FrameLayout>

            <!-- Visual Linking Bracket -->
            <View android:id="@+id/view_link_bracket_vertical"
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginStart="12dp"
                android:background="@color/brand_primary"
                android:alpha="0.4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/txt_width_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_height_label" />

            <View android:id="@+id/view_link_bracket_top"
                android:layout_width="8dp"
                android:layout_height="2dp"
                android:background="@color/brand_primary"
                android:alpha="0.4"
                app:layout_constraintStart_toStartOf="@id/view_link_bracket_vertical"
                app:layout_constraintTop_toTopOf="@id/txt_width_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_width_label" />

            <View android:id="@+id/view_link_bracket_bottom"
                android:layout_width="8dp"
                android:layout_height="2dp"
                android:background="@color/brand_primary"
                android:alpha="0.4"
                app:layout_constraintStart_toStartOf="@id/view_link_bracket_vertical"
                app:layout_constraintTop_toTopOf="@id/txt_height_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_height_label" />

            <!-- Circular Nexus Toggle -->
            <com.google.android.material.button.MaterialButton 
                android:id="@+id/btn_link_correlation"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="0dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_green"
                app:iconSize="14sp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/brand_primary"
                android:backgroundTint="@color/surface_dialog"
                app:strokeColor="@color/brand_primary"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="@id/view_link_bracket_vertical"
                app:layout_constraintBottom_toBottomOf="@id/view_link_bracket_vertical"
                app:layout_constraintStart_toStartOf="@id/view_link_bracket_vertical"
                app:layout_constraintEnd_toEndOf="@id/view_link_bracket_vertical" />

            <!-- X Position Slider Row -->
            <TextView android:id="@+id/txt_x_label"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="@string/move_x" 
                android:textColor="@color/text_secondary" 
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/txt_height_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.25" />

            <SeekBar android:id="@+id/slider_x" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:max="200" 
                android:progress="100" 
                android:thumbTint="@color/brand_primary" 
                android:progressTint="@color/brand_primary" 
                app:layout_constraintTop_toTopOf="@id/txt_x_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_x_label"
                app:layout_constraintStart_toEndOf="@id/txt_x_label"
                app:layout_constraintEnd_toStartOf="@+id/txt_x_val" />

            <TextView android:id="@+id/txt_x_val" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="0" 
                android:gravity="end" 
                android:textColor="@color/text_primary" 
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/txt_x_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_x_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.1" />

            <!-- Y Position Slider Row -->
            <TextView android:id="@+id/txt_y_label"
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="@string/move_y" 
                android:textColor="@color/text_secondary" 
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/txt_x_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.25" />

            <SeekBar android:id="@+id/slider_y" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:max="200" 
                android:progress="100" 
                android:thumbTint="@color/brand_primary" 
                android:progressTint="@color/brand_primary" 
                app:layout_constraintTop_toTopOf="@id/txt_y_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_y_label"
                app:layout_constraintStart_toEndOf="@id/txt_y_label"
                app:layout_constraintEnd_toStartOf="@+id/txt_y_val" />

            <TextView android:id="@+id/txt_y_val" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:text="0" 
                android:gravity="end" 
                android:textColor="@color/text_primary" 
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/txt_y_label"
                app:layout_constraintBottom_toBottomOf="@id/txt_y_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.1" />

            <!-- Thickness Slider Row -->
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layout_thickness"
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/txt_y_label"
                app:layout_constraintStart_toStartOf="parent">

                <TextView android:id="@+id/txt_thickness_label"
                    android:layout_width="0dp" 
                    android:layout_height="wrap_content" 
                    android:text="@string/thickness" 
                    android:textColor="@color/text_secondary" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.25" />

                <SeekBar android:id="@+id/slider_thickness" 
                    android:layout_width="0dp" 
                    android:layout_height="wrap_content" 
                    android:max="20" 
                    android:progress="2" 
                    android:thumbTint="@color/brand_primary" 
                    android:progressTint="@color/brand_primary" 
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/txt_thickness_label"
                    app:layout_constraintEnd_toStartOf="@+id/txt_thickness_val" />

                <TextView android:id="@+id/txt_thickness_val" 
                    android:layout_width="0dp" 
                    android:layout_height="wrap_content" 
                    android:text="2" 
                    android:gravity="end" 
                    android:textColor="@color/text_primary" 
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.1" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- No Frame Toggle -->
            <CheckBox android:id="@+id/chk_no_frame" 
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content" 
                android:text="@string/no_frame" 
                android:textColor="@color/text_secondary" 
                android:layout_marginTop="16dp" 
                android:buttonTint="@color/brand_primary"
                app:layout_constraintTop_toBottomOf="@id/layout_thickness"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Frame Color Row -->
            <LinearLayout android:id="@+id/layout_frame_color" 
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:orientation="horizontal" 
                android:gravity="center_vertical" 
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/chk_no_frame"
                app:layout_constraintStart_toStartOf="parent">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/frame_color" android:textColor="@color/text_secondary" android:minWidth="80dp" />
                <View android:id="@+id/view_frame_color_indicator" android:layout_width="24dp" android:layout_height="24dp" android:background="@color/surface_card_nested" android:layout_marginEnd="12dp" />
                <Button android:id="@+id/btn_change_frame_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/change" style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <!-- Corner Selection Row -->
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/layout_corners_selection"
                android:layout_width="match_parent" 
                android:layout_height="wrap_content" 
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/layout_frame_color"
                app:layout_constraintStart_toStartOf="parent">
                <TextView android:id="@+id/txt_corners_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/round_corners" android:textColor="@color/text_secondary" android:textSize="12sp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/txt_corners_label" app:layout_constraintStart_toStartOf="parent">
                    <CheckBox android:id="@+id/chk_round_tl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/corner_tl" android:textSize="11sp" android:buttonTint="@color/brand_primary" android:textColor="@color/text_primary" />
                    <CheckBox android:id="@+id/chk_round_tr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/corner_tr" android:textSize="11sp" android:buttonTint="@color/brand_primary" android:textColor="@color/text_primary" />
                    <CheckBox android:id="@+id/chk_round_bl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/corner_bl" android:textSize="11sp" android:buttonTint="@color/brand_primary" android:textColor="@color/text_primary" />
                    <CheckBox android:id="@+id/chk_round_br" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:text="@string/corner_br" android:textSize="11sp" android:buttonTint="@color/brand_primary" android:textColor="@color/text_primary" />
                </GridLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.cardview.widget.CardView>
