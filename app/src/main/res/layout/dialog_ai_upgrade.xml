<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="320dp" android:layout_height="wrap_content" android:layout_gravity="center" app:cardBackgroundColor="@color/surface_dialog" app:cardCornerRadius="28dp" app:cardElevation="24dp" app:strokeColor="@color/divider_color_new" app:strokeWidth="1dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="32dp">

        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_automatic_ai" app:tint="@color/text_secondary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:fontFamily="serif" android:text="@string/pro_feature_only" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/pro_feature_desc" android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnUpgradeNow" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp" android:text="@string/upgrade_now" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="28dp" app:backgroundTint="@color/brand_primary" android:textColor="#FFFFFF"/>

        <TextView android:id="@+id/btnMaybeLater" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/maybe_later" android:textColor="@color/text_secondary" android:textSize="14sp" android:textStyle="bold" android:padding="8dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless"/>

        <!-- Try Demo Section -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginTop="16dp">
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_color_new" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/or_text" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="12dp"/>
            
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTryDemo" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/try_demo" android:textAllCaps="false" android:textColor="@color/brand_primary" android:textStyle="bold"/>

            <!-- Demo Input Area (Hidden initially) -->
            <LinearLayout android:id="@+id/layoutDemoInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boxStrokeColor="@color/brand_primary" app:hintTextColor="@color/brand_primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDemoPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/demo_prompt_hint" android:maxLines="3" android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>
                
                <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnDemoSend" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/send" android:textAllCaps="false" app:cornerRadius="24dp"/>
                    <ProgressBar android:id="@+id/pbDemoThinking" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:visibility="gone" android:indeterminateTint="#FFFFFF"/>
                </FrameLayout>

                <TextView android:id="@+id/tvDemoResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_primary" android:textSize="13sp" android:background="@drawable/item_bg_light" android:padding="12dp" android:visibility="gone"/>
                
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/demo_disclaimer" android:textColor="@color/text_secondary" android:textSize="11sp" android:gravity="center" android:fontStyle="italic"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
