<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center" android:background="#FFFFFF" android:elevation="8dp">

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_template_cancel" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="Cancel" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" app:icon="@drawable/ic_close" app:iconGravity="textStart" app:iconTint="#FFFFFF" app:backgroundTint="#FF5252" app:cornerRadius="12dp" app:strokeWidth="0dp" />

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_template_confirm" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Save Template" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" app:icon="@drawable/ic_check" app:iconGravity="textStart" app:iconTint="#FFFFFF" app:backgroundTint="#4CAF50" app:cornerRadius="12dp" app:strokeWidth="0dp" />

</LinearLayout>
