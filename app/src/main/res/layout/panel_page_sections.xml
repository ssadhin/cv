<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@android:color/transparent" android:padding="12dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select Section to Add" android:textStyle="bold" android:textSize="16sp" android:textColor="#000000" android:gravity="center" android:layout_marginBottom="12dp"/>

    <!-- Search Bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:layout_marginBottom="12dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@android:drawable/ic_menu_search" app:tint="#888888"/>
        <EditText android:id="@+id/search_sections" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:hint="Search sections..." android:textSize="14sp" android:paddingStart="8dp" android:inputType="text" android:imeOptions="actionSearch"/>
    </LinearLayout>

    <!-- Toolbar: Sort & Group -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="12dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/btn_sort_az" android:layout_width="wrap_content" android:layout_height="32dp" android:text="A-Z" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#EEF2FF" android:textColor="#1E3C72" android:clickable="true" android:focusable="true"/>
            <View android:layout_width="8dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/btn_sort_usage" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Most Used" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:textColor="#888888" android:clickable="true" android:focusable="true"/>
            <View android:layout_width="8dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/btn_sort_recent" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Recent" android:textSize="12sp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/rounded_box_bg" android:backgroundTint="#F5F5F5" android:textColor="#888888" android:clickable="true" android:focusable="true"/>
            <View android:layout_width="16dp" android:layout_height="1dp"/>
            <CheckBox android:id="@+id/chk_group_by" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grouped" android:textSize="12sp" android:checked="true" android:buttonTint="#1E3C72" android:textAllCaps="false"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 2 Column Scrollable Grid -->
    <!-- 2 Column Manual Scroll Layout -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="vertical" android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/sections_category_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/sections_container">
                <!-- Left Column -->
                <LinearLayout android:id="@+id/column_left" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingRight="4dp"/>
                <!-- Right Column -->
                <LinearLayout android:id="@+id/column_right" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btn_reset_all" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reset Resume Data" android:layout_marginTop="8dp" android:backgroundTint="#F44336" android:textColor="#FFFFFF" android:textAllCaps="false" android:elevation="2dp" android:paddingVertical="12dp"/>

</LinearLayout>
