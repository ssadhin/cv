<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="#33FFFFFF" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#1AFFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">

            <CheckBox android:id="@+id/chk_select" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="0dp" />

            <TextView android:id="@+id/txt_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Item Name" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" android:paddingStart="8dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />

            <View android:id="@+id/view_color_preview" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/shape_icon_bg" android:backgroundTint="#CCCCCC" />
        </LinearLayout>

        <!-- Standard Styling Controls -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:layout_marginBottom="8dp">

            <TextView android:id="@+id/txt_label_font_size" android:text="Font Size" android:textSize="12sp" android:textColor="#000000" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_font_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30" android:progress="14" />

            <TextView android:text="Opacity" android:textSize="12sp" android:textColor="#000000" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_opacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="100" />

            <TextView android:text="Line Height" android:textSize="12sp" android:textColor="#000000" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_line_height" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" android:progress="120" />

            <TextView android:text="Border Radius" android:textSize="12sp" android:textColor="#000000" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_radius" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30" android:progress="0" />

            <TextView android:id="@+id/txt_label_rotate" android:text="Rotation" android:textSize="12sp" android:textColor="#000000" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_row_rotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="0" />

            <TextView android:id="@+id/txt_label_align" android:text="Alignment (L - C - R)" android:textSize="12sp" android:textColor="#000000" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_align" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="2" android:progress="1" />
        </LinearLayout>

        <!-- Dynamic Layout/Transformation Controls -->
        <LinearLayout android:id="@+id/layout_name_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">

            <TextView android:text="Content Transformation" android:textSize="12sp" android:textColor="#5C7CFA" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />

            <TextView android:text="Content Scale" android:textSize="12sp" android:textColor="#000000" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_name_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />

            <TextView android:text="Title Scale" android:textSize="12sp" android:textColor="#000000" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:shadowColor="#FFFFFF" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="1" />
            <SeekBar android:id="@+id/seek_title_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />
        </LinearLayout>

        <!-- Header Background Image Control -->
        <LinearLayout android:id="@+id/layout_bg_image_control" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
            <Button android:id="@+id/btn_bg_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set Header Background Image" android:backgroundTint="#2196F3" android:textColor="#FFFFFF" />
            <TextView android:text="Recommended: High Resolution (e.g. 1920x1080), Landscape Ratio (16:9), JPG/PNG Format. This covers the entire header box." android:textSize="11sp" android:textColor="#666666" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
