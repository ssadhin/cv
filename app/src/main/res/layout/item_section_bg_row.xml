<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="1dp" app:strokeColor="#DDDDDD" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">

            <CheckBox android:id="@+id/chk_select" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="0dp" />

            <TextView android:id="@+id/txt_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item Name" android:textColor="#000000" android:textSize="14sp" android:textStyle="bold" android:paddingStart="8dp" />
        </LinearLayout>


        <!-- Dynamic Layout/Transformation Controls -->


        <LinearLayout android:id="@+id/layout_bg_image_control" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btn_bg_image" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Set Header Background Image" android:backgroundTint="#2196F3" android:textColor="#FFFFFF" />
                <View android:layout_width="8dp" android:layout_height="match_parent" />
                <Button android:id="@+id/btn_remove_bg_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Remove" android:backgroundTint="#F44336" android:textColor="#FFFFFF" />
            </LinearLayout>
            <TextView android:text="Recommended: High Resolution (e.g. 1920x1080), Landscape Ratio (16:9), JPG/PNG Format. This covers the entire header box." android:textSize="11sp" android:textColor="#666666" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

            <TextView android:text="Image Mode (Scaling)" android:textSize="12sp" android:textColor="#000000" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btn_img_fill" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fill" android:backgroundTint="#EEEEEE" android:textColor="#333333" android:textSize="10sp" />
                <View android:layout_width="4dp" android:layout_height="match_parent" />
                <Button android:id="@+id/btn_img_fit" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fit" android:backgroundTint="#EEEEEE" android:textColor="#333333" android:textSize="10sp" />
                <View android:layout_width="4dp" android:layout_height="match_parent" />
                <Button android:id="@+id/btn_img_center" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Center" android:backgroundTint="#EEEEEE" android:textColor="#333333" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Blank Section Specific Controls -->
        <LinearLayout android:id="@+id/layout_blank_section_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp" android:visibility="gone" android:layout_marginTop="8dp">

            <!-- category 1: Transform -->
            <LinearLayout android:id="@+id/header_transform" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:background="#F5F5F5" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="📐 Transform &amp; Layering" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" />
                <TextView android:id="@+id/txt_status_transform" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▾" android:textSize="18sp" android:textColor="#999999" />
            </LinearLayout>
            <LinearLayout android:id="@+id/container_transform" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                <TextView android:text="Size Base (Height / Scale)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="500" android:progress="100" />

                <TextView android:text="Position X (Horizontal %)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_x" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" />

                <TextView android:text="Position Y (Vertical %)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_y" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" />

                <TextView android:text="Rotation (Degrees)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_rotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="0" />

                <TextView android:text="Layering System (Z-Index)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_zindex" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="2" android:progress="1" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                    <TextView android:text="Behind" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp"/>
                    <TextView android:text="Normal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="center"/>
                    <TextView android:text="In Front" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- category 2: Geometry -->
            <LinearLayout android:id="@+id/header_geometry" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:background="#F5F5F5" android:gravity="center_vertical" android:layout_marginTop="4dp" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="💠 Outer Geometry" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" />
                <TextView android:id="@+id/txt_status_geometry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▸" android:textSize="18sp" android:textColor="#999999" />
            </LinearLayout>
            <LinearLayout android:id="@+id/container_geometry" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
                <TextView android:text="Shape" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_shape_rect" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rect" android:textSize="10sp" />
                    <Button android:id="@+id/btn_shape_circle" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Circle" android:textSize="10sp" />
                    <Button android:id="@+id/btn_shape_tri" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tri" android:textSize="10sp" />
                    <Button android:id="@+id/btn_shape_hex" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Hex" android:textSize="10sp" />
                </LinearLayout>

                <TextView android:text="Roundness (Radius px)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_radius" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="500" android:progress="0" />

                <TextView android:text="Smoothing / Edge Rounding" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_smoothing" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="0" />
            </LinearLayout>

            <!-- category 3: Hole -->
            <LinearLayout android:id="@+id/header_hole" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:background="#F5F5F5" android:gravity="center_vertical" android:layout_marginTop="4dp" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🕳️ Hole Design" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" />
                <TextView android:id="@+id/txt_status_hole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▸" android:textSize="18sp" android:textColor="#999999" />
            </LinearLayout>
            <LinearLayout android:id="@+id/container_hole" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
                <TextView android:text="Hole Shape" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_hole_shape_rect" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rect" android:textSize="10sp" />
                    <Button android:id="@+id/btn_hole_shape_circle" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Circle" android:textSize="10sp" />
                    <Button android:id="@+id/btn_hole_shape_tri" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tri" android:textSize="10sp" />
                    <Button android:id="@+id/btn_hole_shape_hex" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Hex" android:textSize="10sp" />
                </LinearLayout>

                <TextView android:text="Hole Size (%)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_hole" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="90" android:progress="0" />
            </LinearLayout>

            <!-- category 4: Appearance -->
            <LinearLayout android:id="@+id/header_appearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:background="#F5F5F5" android:gravity="center_vertical" android:layout_marginTop="4dp" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="🖼️ Background &amp; Style" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" />
                <TextView android:id="@+id/txt_status_appearance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▸" android:textSize="18sp" android:textColor="#999999" />
            </LinearLayout>
            <LinearLayout android:id="@+id/container_appearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
                <TextView android:text="Background Blur" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_blank_blur" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30" android:progress="0" />

                <TextView android:text="Background Image Mode" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_blank_img_fill" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fill" android:textSize="10sp" />
                    <Button android:id="@+id/btn_blank_img_fit" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Fit" android:textSize="10sp" />
                    <Button android:id="@+id/btn_blank_img_center" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Center" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Stick Section Specific Controls -->
        <LinearLayout android:id="@+id/layout_stick_section_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp" android:visibility="gone" android:layout_marginTop="8dp">

            <LinearLayout android:id="@+id/container_stick" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                <!-- Tabs -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/tab_stick_style" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Style" android:gravity="center" android:padding="12dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#000000" android:background="#FFFFFF" />
                    <TextView android:id="@+id/tab_stick_general" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="General" android:gravity="center" android:padding="12dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#888888" android:background="#F5F5F5" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#000000" android:layout_marginBottom="8dp"/>

                <!-- STYLE TAB -->
                <LinearLayout android:id="@+id/layout_stick_style_tab" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:baselineAligned="false">

                    <!-- Left -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:text="Left" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>

                            <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_weight="1" android:padding="8dp">
                                <ScrollView android:id="@+id/scroll_stick_left" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:nestedScrollingEnabled="true" android:scrollbars="none">
                                    <LinearLayout android:id="@+id/list_stick_left_shapes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                                    </LinearLayout>
                                </ScrollView>
                            </FrameLayout>
                        </LinearLayout>

                        <TextView android:text="L height" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start"/>
                        <SeekBar android:id="@+id/seek_stick_left_h" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="20" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <TextView android:text="L Width" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start"/>
                        <SeekBar android:id="@+id/seek_stick_left_w" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="20" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                            <TextView android:text="Proportional" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                            <CheckBox android:id="@+id/chk_stick_left_prop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:scaleX="0.8" android:scaleY="0.8" android:checked="true"/>
                        </LinearLayout>

                        <TextView android:text="Color" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="8dp"/>
                        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="2dp" android:layout_gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
                            <ImageView android:id="@+id/btn_stick_left_color" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" />
                        </androidx.cardview.widget.CardView>

                        <TextView android:text="Shape\nrotation" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="8dp"/>
                        <SeekBar android:id="@+id/seek_stick_left_rot" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="0" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>
                    </LinearLayout>

                    <!-- Middle -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:text="Mid" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>

                            <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_weight="1" android:padding="8dp">
                                <ScrollView android:id="@+id/scroll_stick_mid" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:nestedScrollingEnabled="true" android:scrollbars="none">
                                    <LinearLayout android:id="@+id/list_stick_mid_shapes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                                    </LinearLayout>
                                </ScrollView>
                            </FrameLayout>
                        </LinearLayout>

                        <TextView android:text="M. Heigh" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start"/>
                        <SeekBar android:id="@+id/seek_stick_mid_h" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="2" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <TextView android:text="M. Width" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start"/>
                        <SeekBar android:id="@+id/seek_stick_width" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                            <TextView android:text="Proportional" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                            <CheckBox android:id="@+id/chk_stick_mid_prop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:scaleX="0.8" android:scaleY="0.8" android:checked="false"/>
                        </LinearLayout>

                        <TextView android:text="Color" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="8dp"/>
                        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="2dp" android:layout_gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
                            <ImageView android:id="@+id/btn_stick_mid_color" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" />
                        </androidx.cardview.widget.CardView>

                        <TextView android:text="Shape\nrotation" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="8dp"/>
                        <SeekBar android:id="@+id/seek_stick_mid_rot" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="0" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>
                    </LinearLayout>

                    <!-- Right -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:text="Right" android:textSize="18sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>

                            <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_weight="1" android:padding="8dp">
                                <ScrollView android:id="@+id/scroll_stick_right" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:nestedScrollingEnabled="true" android:scrollbars="none">
                                    <LinearLayout android:id="@+id/list_stick_right_shapes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                                    </LinearLayout>
                                </ScrollView>
                            </FrameLayout>
                        </LinearLayout>

                        <TextView android:text="R. Height" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start"/>
                        <SeekBar android:id="@+id/seek_stick_right_h" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="10" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <TextView android:text="R. Width" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start"/>
                        <SeekBar android:id="@+id/seek_stick_right_w" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="10" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                            <TextView android:text="Proportional" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                            <CheckBox android:id="@+id/chk_stick_right_prop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:scaleX="0.8" android:scaleY="0.8" android:checked="true"/>
                        </LinearLayout>

                        <TextView android:text="Color" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="8dp"/>
                        <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="2dp" android:layout_gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
                            <ImageView android:id="@+id/btn_stick_right_color" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" />
                        </androidx.cardview.widget.CardView>

                        <TextView android:text="Shape\nrotation" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="8dp"/>
                        <SeekBar android:id="@+id/seek_stick_right_rot" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="0" android:thumbTint="#000000" android:progressTint="#000000" android:paddingTop="8dp" android:paddingBottom="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- GENERAL TAB -->
            <LinearLayout android:id="@+id/layout_stick_general_tab" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:text="Line Thickness (px)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_stick_line_thickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="20" android:progress="2" android:thumbTint="#000000" android:progressTint="#000000" />

                <TextView android:text="Line Color" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <androidx.cardview.widget.CardView android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="2dp" android:layout_gravity="center" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
                    <ImageView android:id="@+id/btn_stick_line_color" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" />
                </androidx.cardview.widget.CardView>

                <TextView android:text="Global Rotation (Degrees)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_stick_rotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="0" />

                <TextView android:text="X-Axis Offset (%)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_stick_x_axis" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="200" android:progress="100" />

                <TextView android:text="Spacing Top (px)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_stick_margin_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="20" />

                <TextView android:text="Spacing Bottom (px)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_stick_margin_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="20" />

                <TextView android:text="Stick Edge Radius" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_stick_radius" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" android:progress="0" />

                <TextView android:text="Layering System (Z-Index)" android:textSize="12sp" android:textColor="#666666" android:textAllCaps="true" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" />
                <SeekBar android:id="@+id/seek_stick_zindex" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="2" android:progress="1" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                    <TextView android:text="Behind" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp"/>
                    <TextView android:text="Normal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="center"/>
                    <TextView android:text="In Front" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
