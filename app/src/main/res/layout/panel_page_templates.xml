<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">

        <!-- Unitary Controls Row (Stable fixed height) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">

            <!-- Compact Grid Size Slider (35% width for stability) -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.35" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="4dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_grid" app:tint="@color/text_secondary" />
                <SeekBar android:id="@+id/seekTemplateGridSize" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="3" android:progress="0" />
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_grid" app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Scrollable Buttons & Switch (65% width) -->
            <HorizontalScrollView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.65" android:scrollbars="none" android:fillViewport="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:minHeight="48dp">

                    <!-- Sort Toggle -->
                    <TextView android:id="@+id/btnTemplateSortToggle" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Recent" android:textColor="#000000" android:textSize="10sp" android:background="@drawable/bg_pill_outline" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_marginEnd="6dp" android:stateListAnimator="@animator/wobbly_slime" />

                    <!-- Swap Direction Button -->
                    <ImageButton android:id="@+id/btnTemplateSortDirection" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_swap" android:padding="6dp" android:scaleType="fitCenter" android:background="@drawable/bg_pill_outline" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_marginEnd="6dp" android:stateListAnimator="@animator/wobbly_slime" app:tint="#000000" />

                    <!-- Tag Filter -->
                    <TextView android:id="@+id/btnTemplateTagFilter" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="Tag: All" android:textColor="#000000" android:textSize="10sp" android:background="@drawable/bg_pill_outline" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_marginEnd="6dp" android:stateListAnimator="@animator/wobbly_slime" />

                    <!-- Online / Offline Pill Switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchOnlineOffline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:layout_marginEnd="4dp" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <GridLayout android:id="@+id/user_templates_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:alignmentMode="alignMargins" android:columnOrderPreserved="false" />

        <TextView android:id="@+id/tv_no_templates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No saved templates yet.\nLong-press the Print icon to save one!" android:gravity="center" android:textColor="@color/text_secondary" android:layout_marginTop="20dp"/>
    </LinearLayout>

</ScrollView>
