<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground">

    <androidx.cardview.widget.CardView android:layout_width="60dp" android:layout_height="80dp" app:cardCornerRadius="8dp" app:cardElevation="2dp" android:layout_marginEnd="16dp">

        <ImageView android:id="@+id/ivTemplateThumbnail" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/ic_description" />

    </androidx.cardview.widget.CardView>

    <TextView android:id="@+id/tvTemplateName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Template Name" android:textColor="#333333" android:textSize="16sp" android:textStyle="bold" />

    <RadioButton android:id="@+id/rbSelected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:focusable="false" />

</LinearLayout>
